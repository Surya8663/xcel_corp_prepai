# PrepAI Environment Configuration Example
# Copy this file to .env and fill in your real GEMINI_API_KEY before running docker-compose up.

# ── Gemini AI Configuration ──────────────────────────────────────────────────
# Required: Obtain a free API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL Database Configuration ─────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/database_name
# For Docker Compose local run (uses container service hostname 'postgres'):
DATABASE_URL=postgresql+asyncpg://prepai:prepai_secret@postgres:5432/prepai_db

# ── Application Settings ──────────────────────────────────────────────────────
APP_NAME=PrepAI Backend
APP_VERSION=1.0.0
DEBUG=false

# ── Frontend Public API URL ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
